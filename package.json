{
  "name": "medika-clinic-app",
  "version": "1.0.0",
  "description": "Local-First Clinic Reception & Client Session Spreadsheet System with SQLite & Multi-Device LAN Access",
  "main": "server/index.js",
  "scripts": {
    "install-all": "npm install && npm --prefix client install",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
